    this.init();
  }

  method() {
    return this;
  }
}

const arrow = () => {
  return 42;
};

const arrowShort = () => 42;

async function asyncFunction() {
  return await fetch(url);
}

async () => {
  const data = await fetch(url);
  return data;
};

================================================================================
