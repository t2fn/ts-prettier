  return bar;
}

for (let i = 0; i < 10; i++) {
  console.log(i);
}

for (const x of items) {
  process(x);
}

while (condition) {
  doSomething();
}

do {
  doAnother();
} while (anotherCondition);

if (value) {
  handle(value);
} else {
  handleDefault();
}

